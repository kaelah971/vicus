# Server-only Neon connection string. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Browser origin used in auth documentation and session setup.
VICUS_APP_URL=http://localhost:3000
VICUS_HOME_DOMAIN=localhost

# Optional comma-separated verified mainnet public keys allowed to review missions.
VICUS_ADMIN_WALLET_ADDRESSES=

# Server-only native XLM reward settlement. Testnet is the default development network.
VICUS_REWARD_NETWORK=testnet
VICUS_REWARD_DISTRIBUTOR_SECRET=
VICUS_REWARD_MAX_XLM=1
VICUS_ENABLE_MAINNET_REWARDS=false
